# =============================================================================
# Banco de dados MySQL (MESMO banco do Perfex CRM)
# A API cria o banco e aplica as migrações ao subir.
#
# Opção A (simples): defina host/porta/nome separados.
# Opção B (avançado): defina DB_URL completo (ignora DB_HOST/DB_PORT/DB_NAME).
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=arenagamer
DB_USERNAME=root
DB_PASSWORD=
# DB_USE_SSL=false
# DB_TIMEZONE=UTC

# Opção B — URL JDBC completa (descomente para sobrescrever a opção A):
# DB_URL=jdbc:mysql://127.0.0.1:3306/arenagamer?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true&connectTimeout=10000&socketTimeout=30000
# Docker MySQL (porta 3307 — evita conflito com XAMPP na 3306):
# DB_URL=jdbc:mysql://127.0.0.1:3307/arenagamer?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true&connectTimeout=10000&socketTimeout=30000

# =============================================================================
# Integração com o Perfex CRM
# A compra de créditos SEMPRE gera fatura no Perfex; o saldo é creditado só
# após o pagamento. A API chama o Perfex para criar a fatura.
# =============================================================================
# URL base do Perfex (sem barra final). Ex.: http://localhost/perfex_crm
PERFEX_BASE_URL=http://localhost/perfex_crm
# Segredo do callback interno: copie de ArenaGamer > Configurações no Perfex
# (option "Segredo interno"). Deve ser IDÊNTICO nos dois lados.
PERFEX_INTERNAL_SECRET=
# Caminho do endpoint de criação de fatura (normalmente não precisa mudar):
# PERFEX_CREDIT_INVOICE_PATH=/arenagamer/internal/credit_invoice

# =============================================================================
# Redis e RabbitMQ (localhost se rodar só a API; ou docker compose up -d redis rabbitmq)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# =============================================================================
# Aplicação / Segurança
# =============================================================================
SERVER_PORT=8080
JWT_SECRET=arenaGamerSecretKey2024SuperSecureKeyThatIsLongEnough256bits!!
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800
SPRING_PROFILES_ACTIVE=dev
