# Banco de dados externo (MySQL 8)
# - Desenvolvimento local: use localhost
# - App em Docker + MySQL na máquina host: use host.docker.internal
# - Banco remoto (RDS, Cloud SQL, etc.): use o host/IP do provedor
DB_URL=jdbc:mysql://host.docker.internal:3306/arenagamer?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Redis e RabbitMQ (usados pelo docker-compose; localhost para dev local sem Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

JWT_SECRET=arenaGamerSecretKey2024SuperSecureKeyThatIsLongEnough256bits!!
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
